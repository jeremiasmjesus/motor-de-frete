# Sem DATABASE_URL (ou postgresql://...), o app usa um Postgres embarcado (PGlite)
# gravado em ./data/pglite — funciona sem instalar nada, bom pra rodar local.
# Em produção, aponte pra um Postgres de verdade:
# DATABASE_URL=postgres://usuario:senha@host:5432/motor_de_frete
JWT_SECRET=troque-por-um-segredo-forte-em-producao
PORT=3000

# Chave usada pra criptografar credenciais salvas no banco (ex: senha dos Correios).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# As credenciais dos Correios em si (usuário, senha, cartão de postagem) NÃO ficam
# aqui — são cadastradas pelo painel em /painel/correios.html e guardadas
# criptografadas no banco, pra dar pra trocar sem precisar de deploy.

# App da Nuvemshop Partners (App ID e Client Secret — tela "Chaves de acesso").
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=

# URL pública do servidor, usada pra montar o callback_url que a Nuvemshop chama.
# Em produção: https://motor-de-frete-production.up.railway.app
PUBLIC_BASE_URL=
